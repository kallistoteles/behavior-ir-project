+            }
+            for j in 0..reason["details"]["operands"].as_array().map_or(0, Vec::len) {
+                tested += check_sequences(
+                    &raw,
+                    &label,
+                    &format!("{path}/details/operands/{j}"),
+                    &[("node", Json::Null), ("value", Json::Null)],
+                );
+            }
+        }
+        for (i, step) in raw["trace"].as_array().unwrap().iter().enumerate() {
+            let mut fields = vec![
