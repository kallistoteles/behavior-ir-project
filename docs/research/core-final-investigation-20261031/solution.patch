index 0000000..89a60aa
--- /dev/null
+++ b/crates/behavior-core/tests/replay_materialization.rs
@@ -0,0 +1,113 @@
+#![allow(clippy::unwrap_used)]
+//! Research controls for reuse of a value already decoded inside one replay call.
+#[path = "support/commands.rs"]
+mod model;
+
+use behavior_core::{DecisionRecord, admit, evaluate, replay};
+use serde_json::{Value, json};
+
+fn example() -> (behavior_core::semantic::Module, Value) {
+    let module = admit(&model::module().to_string()).unwrap();
+    let record = evaluate(&module, &model::request(2, true).to_string());
+    assert_eq!(record.as_json()["result"], "ALLOW");
+    (module, record.as_json().clone())
+}
+
+#[test]
+#[cfg(feature = "validation-work")]
+fn replay_does_not_reparse_its_already_strictly_decoded_value() {
+    let (module, record) = example();
+    behavior_core::eval::work::reset();
+    assert!(replay(&module, &record.to_string()).matches);
+    assert_eq!(
+        behavior_core::eval::work::read().record_parse_calls,
+        0,
+        "replay must retain its ingress strict decode without a second DecisionRecord parse"
+    );
+}
+
+#[test]
+fn same_call_reuse_preserves_closed_validation_and_selected_error() {
+    let (module, original) = example();
+    let opposite = admit(include_str!(
+        "../../../tests/fixtures/wire/valid/invoice.json"
+    ))
+    .unwrap();
+    for mutation in 0..6 {
+        let mut bad = original.clone();
+        match mutation {
+            0 => bad["unexpected"] = json!(true),
+            1 => bad["validation_profile"] = json!("unknown"),
+            2 => bad["action"]["hash"] = Value::Null,
+            3 => {
+                bad["facts"].as_object_mut().unwrap().remove("universe");
+            }
+            4 => bad["commands"]["intents"][0]["payload"]["recipient"] = json!(17),
+            _ => bad["result"] = json!("DENY"),
+        }
+        let text = bad.to_string();
+        let error = DecisionRecord::from_json(&text).unwrap_err();
+        let outcome = replay(&module, &text);
+        assert!(!outcome.matches, "mutation {mutation}");
+        assert_eq!(outcome.diff.as_deref(), Some(error.to_string().as_str()));
+        assert_eq!(replay(&opposite, &text).diff, outcome.diff);
+    }
+}
+
+#[test]
+fn strict_value_reuse_preserves_accepted_unicode_and_whitespace() {
+    let mut wire = model::module();
+    wire["actions"][0]["command_effects"][0]["payload"]["recipient"] = model::string("å🚀");
+    let module = admit(&wire.to_string()).unwrap();
+    let record = evaluate(&module, &model::request(2, true).to_string());
+    let escaped = record
+        .to_json_string()
+        .replace('å', "\\u00e5")
+        .replace('🚀', "\\ud83d\\ude80");
+    assert_ne!(escaped, record.to_json_string());
+    assert!(replay(&module, &format!(" \n {escaped} \t")).matches);
+}
+
+#[test]
+fn strict_value_reuse_preserves_module_profile_mismatch() {
+    let (_, record) = example();
+    let opposite = admit(include_str!(
+        "../../../tests/fixtures/wire/valid/invoice.json"
+    ))
+    .unwrap();
+    assert_eq!(
+        replay(&opposite, &record.to_string()).diff.as_deref(),
+        Some("INVALID_DECISION_RECORD: record/module profile mismatch")
+    );
+}
+
+#[test]
+fn same_call_reuse_retains_strict_lexical_ingress() {
+    let (module, original) = example();
+    let text = original.to_string();
+    let mut malformed = vec![
+        format!("{{\"record_version\":\"0.8\",{}", &text[1..]),
+        format!("{{\"record_vers\\u0069on\":\"0.8\",{}", &text[1..]),
+        text[..text.len() - 1].to_owned(),
+    ];
+    for number in ["1.0", "1e0", "-0", "18446744073709551616"] {
+        malformed.push(text.replacen(
+            "\"input\":{}",
+            &format!("\"input\":{{\"bad\":{number}}}"),
+            1,
+        ));
+    }
+    malformed.push(text.replacen("\"input\":{}", "\"input\":{\"a\":1,\"a\":2}", 1));
+    for bad in malformed {
+        assert_ne!(bad, text, "mutation must actually change the input");
+        assert!(DecisionRecord::from_json(&bad).is_err());
+        let outcome = replay(&module, &bad);
+        assert!(!outcome.matches);
+        assert!(
+            outcome
+                .diff
+                .unwrap()
+                .starts_with("INVALID_DECISION_RECORD: record is not valid JSON:")
+        );
+    }
+}
diff --git a/crates/behavior-store/src/documents/frozen_hash_reference.rs b/crates/behavior-store/src/documents/frozen_hash_reference.rs
new file mode 100644
index 0000000..519f82d
--- /dev/null
+++ b/crates/behavior-store/src/documents/frozen_hash_reference.rs
@@ -0,0 +1,134 @@
+#![allow(clippy::unwrap_used, dead_code)]
+use super::*;
+pub(super) trait FrozenHash {
+    fn frozen_hash(&self) -> R<String>;
+}
+impl CommitBundle {
+    fn frozen_governance_candidate(
+        &self,
+    ) -> R<behavior_verify::governance::trusted::GovernanceCandidate> {
+        if self.format != TAG_COMMIT_BUNDLE_V2 {
+            return Err(StoreError::Contract {
+                code: "HISTORY_FORMAT_UPGRADE_REQUIRED",
+                message: "candidate requires a v2 bundle with an exact history head".into(),
+            });
+        }
+        let history = self
+            .evaluated_history
+            .as_ref()
+            .ok_or_else(|| StoreError::BundleInvalid("missing evaluated_history".into()))?;
+        history.validate()?;
+        if history.state_ref() != self.evaluated_state || history.store != self.store {
+            return Err(StoreError::BundleInvalid(
+                "history/state/store basis differs".into(),
+            ));
+        }
+        let content = serde_json::json!({"kind":"action","store":self.store,"evaluated_history":history,"behavior_version":self.behavior_version,"record":self.record,
+            "entity_declarations":self.entity_declarations,"read_set":self.read_set,"read_facts":if self.read_facts.is_null(){serde_json::json!({})}else{self.read_facts.clone()},"write_set":self.write_set,"write_lifecycle":self.write_lifecycle});
+        let transition = hash_of(
+            behavior_verify::hashing::TAG_CANDIDATE_TRANSITION_V2,
+            &content,
+        )?;
+        behavior_verify::governance::trusted::GovernanceCandidate::from_json(&serde_json::json!({"format":"behavior.governance_candidate.v2","content":content,"transition_hash":transition}).to_string())
+            .map_err(|e|StoreError::BundleInvalid(e.to_string()))
+    }
+}
+impl FrozenHash for CommitBundle {
+    fn frozen_hash(&self) -> R<String> {
+        match self.format.as_str() {
+            TAG_COMMIT_BUNDLE => {
+                if self.evaluated_history.is_some()
+                    || self.authorization_context.is_some()
+                    || self
+                        .evidence
+                        .as_ref()
+                        .is_some_and(|e| e.as_trusted().is_some())
+                {
+                    return Err(StoreError::BundleInvalid(
+                        "legacy bundle contains v2 semantics".into(),
+                    ));
+                }
+                hash_of(TAG_COMMIT_BUNDLE, self)
+            }
+            TAG_COMMIT_BUNDLE_V2 => {
+                if self.frozen_governance_candidate()?.hash() != self.transition_hash {
+                    return Err(StoreError::BundleInvalid(
+                        "v2 candidate identity differs".into(),
+                    ));
+                }
+                if self
+                    .evidence
+                    .as_ref()
+                    .is_some_and(|e| e.as_legacy().is_some())
+                {
+                    return Err(StoreError::BundleInvalid(
+                        "v2 bundle cannot contain structural legacy evidence".into(),
+                    ));
+                }
+                hash_of(TAG_COMMIT_BUNDLE_V2, self)
+            }
+            _ => Err(StoreError::BundleInvalid(
+                "unknown commit bundle format".into(),
+            )),
+        }
+    }
+}
+impl TransitionRecord {
+    fn frozen_check_kind(&self) -> R<()> {
+        let valid = match (
+            self.format.as_str(),
+            self.kind.as_deref(),
+            &self.bundle,
+            &self.migration,
+        ) {
+            (TAG_TRANSITION_RECORD, None, Some(b), None) => b.format == TAG_COMMIT_BUNDLE,
+            (TAG_TRANSITION_RECORD, Some(KIND_MIGRATION), None, Some(m)) => m.format.is_none(),
+            (TAG_TRANSITION_RECORD_V2, Some("action"), Some(b), None) => {
+                b.frozen_hash()?;
+                let h = b
+                    .evaluated_history
+                    .as_ref()
+                    .ok_or_else(|| StoreError::BundleInvalid("missing evaluated history".into()))?;
+                h.state_ref() == self.evaluated_against && h.record == self.previous_record
+            }
+            (TAG_TRANSITION_RECORD_V2, Some(KIND_MIGRATION), None, Some(m)) => {
+                m.hash()?;
+                let h = HistoryRef::from_json(
+                    &m.candidate.as_ref().ok_or_else(|| {
+                        StoreError::BundleInvalid("missing migration candidate".into())
+                    })?["content"]["evaluated_history"]
+                        .to_string(),
+                )?;
+                h.state_ref() == self.evaluated_against && h.record == self.previous_record
+            }
+            _ => false,
+        };
+        if !valid {
+            return Err(StoreError::BundleInvalid(
+                "event kind/format/history product differs".into(),
+            ));
+        }
+        if self.format == TAG_TRANSITION_RECORD_V2
+            && (self.evaluated_against != self.committed_on
+                || self.committed_on.position.checked_add(1) != Some(self.position)
+                || self.result_state.position != self.position)
+        {
+            return Err(StoreError::BundleInvalid(
+                "v2 event position/history basis differs".into(),
+            ));
+        }
+        Ok(())
+    }
+}
+impl FrozenHash for TransitionRecord {
+    fn frozen_hash(&self) -> R<String> {
+        self.frozen_check_kind()?;
+        match self.format.as_str() {
+            TAG_TRANSITION_RECORD => hash_of(TAG_TRANSITION_RECORD, self),
+            TAG_TRANSITION_RECORD_V2 => hash_of(TAG_TRANSITION_RECORD_V2, self),
+            _ => Err(StoreError::BundleInvalid(
+                "unknown transition format".into(),
+            )),
+        }
+    }
+}
diff --git a/crates/behavior-store/src/documents/hash_view_tests.rs b/crates/behavior-store/src/documents/hash_view_tests.rs
new file mode 100644
index 0000000..2aa24a8
--- /dev/null
+++ b/crates/behavior-store/src/documents/hash_view_tests.rs
@@ -0,0 +1,293 @@
+#![allow(clippy::unwrap_used, dead_code)]
+use super::*;
+use crate::execution_test_workload::fixture;
+use crate::{Backend, InMemoryBackend, Store};
+use serde_json::{Value, json};
+use std::cell::Cell;
+#[path = "frozen_hash_reference.rs"]
+mod frozen;
+use frozen::FrozenHash;
+
+thread_local! { static COPIES: Cell<usize> = const { Cell::new(0) }; }
+pub(super) fn note_materialization(tag: &str) {
+    if [
+        TAG_COMMIT_BUNDLE,
+        TAG_COMMIT_BUNDLE_V2,
+        TAG_TRANSITION_RECORD,
+        TAG_TRANSITION_RECORD_V2,
+        behavior_verify::hashing::TAG_CANDIDATE_TRANSITION_V2,
+    ]
+    .contains(&tag)
+    {
+        COPIES.with(|n| n.set(n.get() + 1));
+    }
+}
+
+fn sample(commands: usize) -> (CommitBundle, TransitionRecord) {
+    let case = fixture::Case {
+        n: 4,
+        commands,
+        ..Default::default()
+    };
+    let module = fixture::module(&case);
+    let mut store = Store::create(
+        InMemoryBackend::new(),
+        &module,
+        fixture::genesis(&case, &module),
+    )
+    .unwrap();
+    let bundle = store
+        .evaluate(
+            &module,
+            "create",
+            &BTreeMap::new(),
+            &json!({"id0":"new0_0"}),
+            &json!({}),
+            "2026-10-28T00:00:00Z",
+            None,
+        )
+        .unwrap()
+        .bundle
+        .unwrap();
+    store
+        .commit(&module, &bundle.evaluated_state, &bundle)
+        .unwrap();
+    (bundle, store.backend().record(1).unwrap().unwrap())
+}
+
+fn goal(commands: usize, event: bool) {
+    let (bundle, record) = sample(commands);
+    let expected = if event {
+        record.frozen_hash()
+    } else {
+        bundle.frozen_hash()
+    };
+    COPIES.with(|n| n.set(0));
+    let actual = if event { record.hash() } else { bundle.hash() };
+    assert_eq!(actual, expected);
+    assert_eq!(
+        COPIES.with(Cell::get),
+        0,
+        "known document hashing must borrow large JSON inputs"
+    );
+}
+
+#[test]
+fn legacy_bundle_does_not_materialize_known_json_again() {
+    goal(0, false);
+}
+#[test]
+fn v2_bundle_does_not_materialize_known_json_again() {
+    goal(2, false);
+}
+#[test]
+fn legacy_event_does_not_materialize_known_json_again() {
+    goal(0, true);
+}
+#[test]
+fn v2_event_does_not_materialize_known_json_again() {
+    goal(2, true);
+}
+
+#[test]
+fn typed_hashes_match_frozen_methods_for_field_mutations_and_omissions() {
+    let mutations = vec![
+        Value::Null,
+        json!(false),
+        json!(0),
+        json!(u64::MAX),
+        json!(0.5),
+        json!(""),
+        json!("é\n\""),
+        json!([]),
+        json!({}),
+        json!([null]),
+        json!({"a":0.5}),
+    ];
+    let mut compared = 0;
+    for commands in [0, 2] {
+        let (bundle, event) = sample(commands);
+        assert_eq!(bundle.hash(), bundle.frozen_hash());
+        assert_eq!(
+            serde_json::to_vec(&views::bundle_view(&bundle).unwrap()).unwrap(),
+            serde_json::to_vec(&serde_json::to_value(&bundle).unwrap()).unwrap()
+        );
+        assert_eq!(event.hash(), event.frozen_hash());
+        assert_eq!(
+            serde_json::to_vec(&views::event_view(&event).unwrap()).unwrap(),
+            serde_json::to_vec(&serde_json::to_value(&event).unwrap()).unwrap()
+        );
+        let base = serde_json::to_value(&bundle).unwrap();
+        for key in [
+            "format",
+            "evaluated_state",
+            "behavior_version",
+            "store",
+            "record",
+            "transition_hash",
+            "entity_declarations",
+            "read_set",
+            "write_set",
+            "read_facts",
+            "write_lifecycle",
+            "commit_time",
+            "evidence",
+            "evaluated_history",
+            "authorization_context",
+        ] {
+            for value in &mutations {
+                let mut raw = base.clone();
+                raw[key] = value.clone();
+                if let Ok(doc) = serde_json::from_value::<CommitBundle>(raw) {
+                    assert_eq!(doc.hash(), doc.frozen_hash(), "bundle {key}={value}");
+                    compared += 1;
+                }
+            }
+            let mut raw = base.clone();
+            raw.as_object_mut().unwrap().remove(key);
+            if let Ok(doc) = serde_json::from_value::<CommitBundle>(raw) {
+                assert_eq!(doc.hash(), doc.frozen_hash());
+                compared += 1;
+            }
+        }
+        let base = serde_json::to_value(&event).unwrap();
+        for key in [
+            "format",
+            "position",
+            "previous_record",
+            "kind",
+            "bundle",
+            "migration",
+            "bundle_hash",
+            "evaluated_against",
+            "committed_on",
+            "result_state",
+            "new_versions",
+            "evidence_policy",
+            "authorization",
+            "created",
+            "removed",
+            "ref_changes",
+        ] {
+            for value in &mutations {
+                let mut raw = base.clone();
+                raw[key] = value.clone();
+                if let Ok(doc) = serde_json::from_value::<TransitionRecord>(raw) {
+                    assert_eq!(doc.hash(), doc.frozen_hash(), "event {key}={value}");
+                    compared += 1;
+                }
+            }
+            let mut raw = base.clone();
+            raw.as_object_mut().unwrap().remove(key);
+            if let Ok(doc) = serde_json::from_value::<TransitionRecord>(raw) {
+                assert_eq!(doc.hash(), doc.frozen_hash());
+                compared += 1;
+            }
+        }
+        for number in [i64::MIN, -1, 0, i64::MAX] {
+            let mut doc = bundle.clone();
+            doc.record = json!({"a":number,"hash":{"metadata":"kept nested"}});
+            assert_eq!(doc.hash(), doc.frozen_hash());
+            compared += 1;
+        }
+    }
+    assert!(compared > 150);
+    eprintln!("typed-document differential cases={compared}");
+}
+
+#[test]
+fn canonical_error_order_is_over_the_whole_composed_document() {
+    let (mut bundle, mut event) = sample(0);
+    bundle.record = json!({"a":0.5});
+    bundle.read_facts = json!({"z":0.25});
+    assert_eq!(
+        bundle.hash(),
+        Err(StoreError::BundleInvalid(
+            "floating-point number in output at $.read_facts.z".into()
+        ))
+    );
+    assert_eq!(bundle.hash(), bundle.frozen_hash());
+    event.bundle = Some(bundle);
+    event.authorization = Some("ok".into());
+    assert_eq!(
+        event.hash(),
+        Err(StoreError::BundleInvalid(
+            "floating-point number in output at $.bundle.read_facts.z".into()
+        ))
+    );
+    assert_eq!(event.hash(), event.frozen_hash());
+}
+
+#[test]
+fn generic_hash_of_retains_value_conversion_and_map_reduction_semantics() {
+    struct Duplicate;
+    impl Serialize for Duplicate {
+        fn serialize<S: serde::Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+            use serde::ser::SerializeMap;
+            let mut map = serializer.serialize_map(Some(2))?;
+            map.serialize_entry("same", &1)?;
+            map.serialize_entry("same", &2)?;
+            map.end()
+        }
+    }
+    assert_eq!(
+        hash_of("generic", &Duplicate),
+        hash_of("generic", &json!({"same":2}))
+    );
+    let error = hash_of("generic", &i128::MAX).unwrap_err();
+    assert_eq!(
+        error,
+        StoreError::BundleInvalid("number out of range".into())
+    );
+    assert_eq!(
+        hash_of("generic", &f64::NAN),
+        hash_of("generic", &Value::Null)
+    );
+}
+
+#[test]
+fn nested_legacy_bundle_does_not_gain_new_semantic_validation() {
+    let (_, mut event) = sample(0);
+    let bundle = event.bundle.as_mut().unwrap();
+    bundle.authorization_context = Some(json!({}));
+    assert!(bundle.hash().is_err());
+    assert!(event.hash().is_ok());
+    assert_eq!(event.hash(), event.frozen_hash());
+    event.bundle.as_mut().unwrap().record = json!({"float":0.5});
+    event.kind = Some("invalid".into());
+    assert_eq!(
+        event.hash(),
+        Err(StoreError::BundleInvalid(
+            "event kind/format/history product differs".into()
+        ))
+    );
+    assert_eq!(event.hash(), event.frozen_hash());
+}
+
+#[test]
+fn some_null_context_is_included_while_none_is_omitted() {
+    let (mut bundle, _) = sample(2);
+    let absent = bundle.hash().unwrap();
+    bundle.authorization_context = Some(Value::Null);
+    assert_ne!(bundle.hash().unwrap(), absent);
+    assert_eq!(bundle.hash(), bundle.frozen_hash());
+}
+
+#[test]
+fn generic_serialize_failure_after_a_float_precedes_canonical_validation() {
+    struct Failure;
+    impl Serialize for Failure {
+        fn serialize<S: serde::Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+            use serde::ser::SerializeMap;
+            let mut map = serializer.serialize_map(None)?;
+            map.serialize_entry("a", &0.5)?;
+            Err(serde::ser::Error::custom("late custom serializer failure"))
+        }
+    }
+    assert_eq!(
+        hash_of("generic", &Failure),
+        Err(StoreError::BundleInvalid(
+            "late custom serializer failure".into()
+        ))
+    );
+}
diff --git a/crates/behavior-store/src/documents/views.rs b/crates/behavior-store/src/documents/views.rs
new file mode 100644
index 0000000..84a5768
--- /dev/null
+++ b/crates/behavior-store/src/documents/views.rs
@@ -0,0 +1,104 @@
+//! Fixed schema views preserve derive field evaluation order and omission predicates.
+use super::*;
+use behavior_core::canonical::{DocumentView, tagged_hash_view};
+
+fn owned<T: Serialize>(value: &T) -> R<DocumentView<'_>> {
+    serde_json::to_value(value)
+        .map(DocumentView::Owned)
+        .map_err(|error| StoreError::BundleInvalid(error.to_string()))
+}
+
+pub(super) fn bundle_view(bundle: &CommitBundle) -> R<DocumentView<'_>> {
+    let mut fields = BTreeMap::new();
+    macro_rules! field {
+        ($name:ident) => {
+            fields.insert(stringify!($name), owned(&bundle.$name)?);
+        };
+    }
+    field!(format);
+    field!(evaluated_state);
+    field!(behavior_version);
+    field!(store);
+    fields.insert("record", DocumentView::Borrowed(&bundle.record));
+    field!(transition_hash);
+    field!(entity_declarations);
+    field!(read_set);
+    field!(write_set);
+    if !bundle.read_facts.is_null() {
+        fields.insert("read_facts", DocumentView::Borrowed(&bundle.read_facts));
+    }
+    if !bundle.write_lifecycle.is_empty() {
+        field!(write_lifecycle);
+    }
+    field!(commit_time);
+    if bundle.evidence.is_some() {
+        field!(evidence);
+    }
+    if bundle.evaluated_history.is_some() {
+        field!(evaluated_history);
+    }
+    if let Some(context) = &bundle.authorization_context {
+        fields.insert("authorization_context", DocumentView::Borrowed(context));
+    }
+    Ok(DocumentView::Object(fields))
+}
+
+pub(super) fn event_view(event: &TransitionRecord) -> R<DocumentView<'_>> {
+    let mut fields = BTreeMap::new();
+    macro_rules! field {
+        ($name:ident) => {
+            fields.insert(stringify!($name), owned(&event.$name)?);
+        };
+    }
+    field!(format);
+    field!(position);
+    field!(previous_record);
+    if event.kind.is_some() {
+        field!(kind);
+    }
+    if let Some(bundle) = &event.bundle {
+        fields.insert("bundle", bundle_view(bundle)?);
+    }
+    if event.migration.is_some() {
+        field!(migration);
+    }
+    field!(bundle_hash);
+    field!(evaluated_against);
+    field!(committed_on);
+    field!(result_state);
+    field!(new_versions);
+    field!(evidence_policy);
+    field!(authorization);
+    if !event.created.is_empty() {
+        field!(created);
+    }
+    if !event.removed.is_empty() {
+        field!(removed);
+    }
+    if !event.ref_changes.is_empty() {
+        field!(ref_changes);
+    }
+    Ok(DocumentView::Object(fields))
+}
+
+fn hash_view(tag: &str, view: &DocumentView<'_>) -> R<String> {
+    #[cfg(feature = "validation-work")]
+    {
+        let bytes = serde_json::to_string(view)
+            .map_err(|error| StoreError::BundleInvalid(error.to_string()))?
+            .len();
+        behavior_core::eval::work::note(|work| {
+            work.document_hash_calls += 1;
+            work.hash_document_json_bytes += bytes;
+        });
+    }
+    tagged_hash_view(tag, view).map_err(|error| StoreError::BundleInvalid(error.to_string()))
+}
+
+pub(super) fn hash_bundle(tag: &str, bundle: &CommitBundle) -> R<String> {
+    hash_view(tag, &bundle_view(bundle)?)
+}
+
+pub(super) fn hash_event(tag: &str, event: &TransitionRecord) -> R<String> {
+    hash_view(tag, &event_view(event)?)
+}
