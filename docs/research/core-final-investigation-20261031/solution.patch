+            }
+            let count = raw["trace"][i]["rescales"].as_array().map_or(0, Vec::len);
+            for j in 0..count {
+                for number in [
+                    json!(-1),
+                    json!(28),
+                    json!(29),
+                    json!(255),
+                    json!(256),
+                    json!(u64::MAX),
+                ] {
+                    let mut changed = raw.clone();
+                    changed["trace"][i]["rescales"][j]["scale"] = number;
